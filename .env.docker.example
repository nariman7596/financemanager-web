# Copy to `.env` next to docker-compose.yml on the VPS:  cp .env.docker.example .env
# docker compose reads these to build DATABASE_URL and pass secrets to the app.
# This file is git-ignored via .env* rules — never commit the filled-in .env.

# Postgres password (the app's DATABASE_URL is assembled from it in compose).
DB_PASSWORD=change-me-to-a-strong-password

# Session signing + cron guard. Generate each with: openssl rand -base64 32
AUTH_SECRET=change-me
CRON_SECRET=change-me

# Private-only deploys (docker-compose.private.yml): set this to false when you
# reach the app over plain HTTP at a VPN/LAN address instead of localhost.
# Session cookies are Secure by default and browsers withhold them over http://,
# which silently bounces you back to the login page. Never set it on a
# publicly-reachable instance. See docs/DEPLOY-PRIVATE.md.
# COOKIE_SECURE=false

# Public access from a phone's browser (docker-compose.public.yml). Uncomment
# all three. APP_DOMAIN with no domain of your own: the server IP with dashes
# plus .sslip.io, e.g. 1-2-3-4.sslip.io. See docs/DEPLOY-PUBLIC.md.
# COMPOSE_FILE=docker-compose.ghcr.yml:docker-compose.public.yml
# APP_DOMAIN=1-2-3-4.sslip.io
# Reach the app only through a VPN on this server (docs/DEPLOY-PUBLIC.md):
# HTTPS_BIND=127.0.0.1
# Close sign-up once your own accounts exist (invited emails still work):
# ALLOW_REGISTRATION=false

# Optional: Finnhub key to auto-refresh stock/ETF prices.
# STOCK_API_KEY=your-finnhub-key

# Optional: bank sync (Plaid). Sandbox keys at dashboard.plaid.com.
# TOKEN_ENCRYPTION_KEY encrypts the stored bank access token — generate with
# the same openssl command as above once Plaid vars are set.
# PLAID_CLIENT_ID=your-plaid-client-id
# PLAID_SECRET=your-plaid-secret
# PLAID_ENV=sandbox
# TOKEN_ENCRYPTION_KEY=change-me
