# pnpm's default strict node_modules is what we want (it is the reason we moved
# off npm — see ARCHITECTURE.md D2: React Native breaks on duplicated copies of
# react/react-native that npm's hoisting happily creates).
#
# Next.js resolves a few plugins from the workspace root rather than from the
# importing package, so those are hoisted explicitly instead of loosening the
# whole tree.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=postcss
public-hoist-pattern[]=autoprefixer
public-hoist-pattern[]=tailwindcss

# Prisma's postinstall needs to run; without this pnpm silently skips it and
# the generated client goes missing at build time.
enable-pre-post-scripts=true
