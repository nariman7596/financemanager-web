{
  "name": "@financemanager/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "encrypt:backfill": "tsx scripts/encrypt-backfill.ts",
    "key:rotate": "tsx scripts/rotate-key.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@financemanager/core": "workspace:*",
    "@financemanager/i18n": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@financemanager/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
