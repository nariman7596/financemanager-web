// FinanceManager data model
// ---------------------------------------------------------------------------
// PostgreSQL everywhere (dev + prod), run via Docker — see docs/DOCKER.md.
// Locally: `docker compose -f docker-compose.dev.yml up -d` gives you Postgres;
// in production the app + its Postgres run as containers (docker-compose.yml).
// Note: Postgres has native enums, but we keep "enum-like" fields as validated
// strings (see src/lib/constants.ts + zod) to stay portable.
//
// If you have a pooled Postgres (e.g. serverless), add:
//   directUrl = env("DIRECT_URL")   // direct connection for migrations
//
// OWNERSHIP MODEL: financial data belongs to a Household, not a User. Users
// join households via Membership (with a role); every query is scoped by
// householdId and gated by the caller's membership + role (src/lib/household.ts).
// `createdById` records who added a row (informational; a plain id, no FK).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled Postgres (Neon/Supabase/serverless) needs a direct connection for
  // migrations. Set both in production; locally they can be the same value.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  baseCurrency String   @default("USD") // personal default for new households
  locale       String   @default("en") // preferred UI language (en | fa)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  devices       Device[]
  refreshTokens RefreshToken[]
}

// A shared financial space. A user working solo has a household of one.
model Household {
  id           String   @id @default(cuid())
  name         String
  baseCurrency String   @default("USD") // reporting currency for this household
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Monotonic change counter for this household. Every write bumps it inside
  // the same transaction and stamps the row's `revision`, giving sync a total
  // order per tenant that no device clock can skew.
  syncRevision BigInt @default(0)

  members      Membership[]
  invitations  Invitation[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]
  recurring    RecurringTransaction[]
  plaidItems   PlaidItem[]
  conflicts    SyncConflict[]
  cursors      SyncCursor[]
  key          HouseholdKey?
}

// Links a user to a household with a role.
// Roles (rank): VIEWER < MEMBER < ADMIN < OWNER.
model Membership {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  role        String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId])
}

// A pending invitation to join a household, keyed by email. Accepting it
// creates a Membership; the invitee may already have an account or sign up later.
model Invitation {
  id          String   @id @default(cuid())
  householdId String
  email       String // lowercased invitee email
  role        String   @default("MEMBER")
  invitedById String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
  @@index([email])
}

// A place money lives: checking, savings, cash, credit card, etc.
model Account {
  id             String   @id @default(cuid())
  householdId    String
  createdById    String?
  name           String
  type           String   @default("CHECKING") // CHECKING | SAVINGS | CASH | CREDIT_CARD | INVESTMENT | OTHER
  currency       String   @default("USD")
  openingBalance Decimal  @default(0)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Bank sync (see src/lib/plaid.ts): set when this Account is linked to a
  // real bank account via Plaid instead of being purely manually tracked.
  source         String  @default("MANUAL") // MANUAL | PLAID
  plaidItemId    String?
  plaidAccountId String? // Plaid's account_id within the item

  // --- sync envelope (ARCHITECTURE.md §4) ---
  // `revision` is assigned by the server from Household.syncRevision inside the
  // write transaction; client clocks are never trusted for ordering. Deletes
  // are tombstones so other devices learn about them.
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  household            Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plaidItem            PlaidItem?             @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions         Transaction[]          @relation("AccountTransactions")
  transferTransactions Transaction[]          @relation("TransferAccount")
  investments          Investment[]
  recurring            RecurringTransaction[] @relation("RecurringAccount")
  recurringTransfers   RecurringTransaction[] @relation("RecurringTransferAccount")

  @@unique([plaidItemId, plaidAccountId])
  @@index([householdId])
  @@index([householdId, revision, id])
}

// Income / expense category.
model Category {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  name        String
  type        String   @default("EXPENSE") // INCOME | EXPENSE | INVESTMENT
  color       String   @default("#328eff")
  icon        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Exactly ONE level of nesting. Arbitrary depth would make every report a
  // recursive CTE and every budget ambiguous about whether it covers
  // descendants. A parent may still hold transactions directly and reports
  // roll children up into it — requiring a leaf would have orphaned every
  // transaction already filed against a top-level category.
  parentId String?

  // Which built-in default this row came from, or null if the household made
  // it. Language switching relabels seeded rows (relabelDefaults); matching on
  // the localised NAME broke as soon as a user renamed a category to something
  // that collided with another locale's seed text. The key is stable.
  seedKey String?

  // --- sync envelope (ARCHITECTURE.md §4) ---
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]             @relation("CategoryTree")
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  // NOTE: uniqueness is enforced by TWO PARTIAL INDEXES created by hand in the
  // migration, not by @@unique. A plain unique index over (householdId,
  // parentId, name, type) does NOT stop duplicate top-level categories,
  // because Postgres treats NULLs as distinct -- two rows with parentId NULL
  // and the same name both insert happily. Verified against a real Postgres.
  // See the migration for the two indexes that cover both cases.
  @@index([householdId])
  @@index([householdId, parentId])
  @@index([householdId, revision, id])
}

// A single money movement.
model Transaction {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  accountId   String
  categoryId  String?
  type        String   @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  amount      Decimal // always positive; `type` gives the direction
  currency    String   @default("USD")
  date        DateTime @default(now())
  description String?
  notes       String?

  // Legacy per-transaction recurrence flags (unused; see RecurringTransaction).
  isRecurring Boolean @default(false)
  recurrence  String?

  transferAccountId String?
  recurringId       String?

  // Bank sync: set when this row was materialized from a Plaid transaction
  // (see src/lib/plaid.ts). plaidTransactionId is the dedup key — sync
  // upserts on it instead of blindly inserting, unlike the CSV importer.
  plaidTransactionId String? @unique
  pending            Boolean @default(false)

  // --- provenance: where did this row come from? ---
  origin String @default("MANUAL") // MANUAL | IMPORT | PLAID | SMS | RECURRING

  // SMS ingest (ARCHITECTURE.md §5). `smsHash` is sha256 of the NORMALISED
  // message body and is the dedup key: the same message read by the Android
  // reader and also pasted by hand must become one transaction, not two.
  // `rawSms` is encrypted at rest in Phase 5 -- bank messages carry balances
  // and partial account numbers.
  rawSms        String?
  smsHash       String?
  smsConfidence Float?

  // A low-confidence parse becomes a draft for review rather than a posted
  // transaction. Money the user did not enter must never appear unannounced.
  needsReview Boolean @default(false)

  // --- sync envelope (ARCHITECTURE.md §4) ---
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account               @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?              @relation("TransferAccount", fields: [transferAccountId], references: [id])
  category        Category?             @relation(fields: [categoryId], references: [id])
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  // One SMS can only ever become one transaction in a household.
  @@unique([householdId, smsHash])
  @@index([householdId, date])
  @@index([householdId, revision, id])
  @@index([accountId])
  @@index([categoryId])
  @@index([recurringId])
}

// A recurring rule / template (see src/lib/recurring.ts).
model RecurringTransaction {
  id                String  @id @default(cuid())
  householdId       String
  createdById       String?
  accountId         String
  categoryId        String?
  transferAccountId String?
  type              String  @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  amount            Decimal
  currency          String  @default("USD")
  description       String?
  notes             String?

  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  interval    Int       @default(1) // every N frequency units
  // Calendar the MONTHLY/YEARLY step is measured in. "Monthly" means the same
  // day of the next month in the calendar the owner actually uses: a rule set
  // for 15 Mordad must post on 15 Shahrivar, not 3 days off it. Frozen on the
  // rule so changing the UI language never shifts money that is already
  // scheduled. Ignored for DAILY/WEEKLY, which are calendar-independent.
  calendar    String    @default("GREGORIAN") // GREGORIAN | JALALI
  startDate   DateTime // first occurrence
  nextRunDate DateTime // next date to post
  endDate     DateTime? // optional stop date (inclusive)
  lastPosted  DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- sync envelope (ARCHITECTURE.md §4) ---
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account       @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?      @relation("RecurringTransferAccount", fields: [transferAccountId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  transactions    Transaction[]

  @@index([householdId])
  @@index([householdId, revision, id])
  @@index([isActive, nextRunDate])
}

// Monthly/weekly/yearly spending target for a category.
model Budget {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  categoryId  String
  amount      Decimal
  currency    String   @default("USD")
  period      String   @default("MONTHLY") // WEEKLY | MONTHLY | YEARLY
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- sync envelope (ARCHITECTURE.md §4) ---
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, period])
  @@index([householdId])
  @@index([householdId, revision, id])
}

// An investment holding: stock, crypto, ETF, etc.
model Investment {
  id           String   @id @default(cuid())
  householdId  String
  createdById  String?
  accountId    String?
  symbol       String
  name         String
  type         String   @default("STOCK") // STOCK | ETF | CRYPTO | BOND | REAL_ESTATE | CASH | OTHER
  quantity     Decimal
  costBasis    Decimal
  currentPrice Decimal  @default(0)
  currency     String   @default("USD")
  purchaseDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- sync envelope (ARCHITECTURE.md §4) ---
  revision           BigInt    @default(0)
  deletedAt          DateTime?
  lastWriterDeviceId String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id])

  @@index([householdId])
  @@index([householdId, revision, id])
}

// A linked bank connection via Plaid (see src/lib/plaid.ts). One item can
// cover multiple of the institution's accounts; each gets mapped to at most
// one local Account (Account.plaidItemId/plaidAccountId).
model PlaidItem {
  id                 String    @id @default(cuid())
  householdId        String
  createdById        String?
  itemId             String    @unique // Plaid item_id
  accessToken        String // AES-256-GCM encrypted, see src/lib/crypto.ts
  institutionName    String?
  status             String    @default("ACTIVE") // ACTIVE | ERROR | REVOKED
  error              String?
  transactionsCursor String? // Plaid /transactions/sync cursor
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@index([householdId])
}

// Exchange rate cache for multi-currency conversion (quote per 1 base).
model ExchangeRate {
  id    String   @id @default(cuid())
  base  String
  quote String
  rate  Decimal
  asOf  DateTime @default(now())

  @@unique([base, quote])
}

// ---------------------------------------------------------------------------
// Sync, devices and keys (ARCHITECTURE.md §4 and §6). Nothing reads these yet;
// Phase 4 (the API) and Phase 6 (the sync protocol) fill them in. They land in
// one migration so there is a single risky schema change rather than five.
// ---------------------------------------------------------------------------

// A registered installation. Sync cursors are per-device, not per-user: a
// phone and a laptop pull independently and are at different revisions.
model Device {
  id         String   @id // client-generated UUID
  userId     String
  platform   String // IOS | ANDROID | WEB
  name       String? // "Nariman's iPhone"
  pushToken  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cursors SyncCursor[]

  @@index([userId])
}

// How far this device has read, per household.
model SyncCursor {
  deviceId     String
  householdId  String
  lastRevision BigInt   @default(0)
  lastSyncedAt DateTime @default(now())

  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([deviceId, householdId])
}

// Idempotency ledger. A push retried after a network timeout must not apply
// twice, so every mutation carries a client-generated opId that is recorded
// here. Pruned after 30 days.
model SyncOperation {
  opId            String   @id // client-generated UUID, one per mutation
  deviceId        String
  householdId     String
  entity          String // "transaction" | "category" | ...
  entityId        String
  appliedRevision BigInt
  appliedAt       DateTime @default(now())

  @@index([householdId, appliedAt])
}

// A write that lost to a concurrent write. Last-writer-wins decides the row,
// but the loser is kept and shown to the user: silently discarding a figure
// somebody typed is not acceptable in a ledger.
model SyncConflict {
  id              String    @id @default(cuid())
  householdId     String
  entity          String
  entityId        String
  losingPayload   Json // encrypted in Phase 5 when it carries narrative fields
  winningRevision BigInt
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, resolvedAt])
}

// Refresh-token rotation for mobile (Phase 4). One row per live session. Reuse
// of an already-rotated token revokes the whole family, which is how a stolen
// token is detected.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  deviceId  String
  tokenHash String    @unique // sha256 -- the token itself is never stored
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

// Envelope encryption (Phase 5): one data key per household, itself encrypted
// with the master key from the environment. Rotating the master key re-wraps
// these rows and never touches the data.
model HouseholdKey {
  householdId String   @id
  wrappedDek  String // AES-256-GCM(KEK, DEK)
  keyVersion  Int      @default(1)
  rotatedAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
