{
  "name": "financemanager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @financemanager/web start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @financemanager/db db:generate",
    "db:push": "pnpm --filter @financemanager/db db:push",
    "db:migrate": "pnpm --filter @financemanager/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @financemanager/db db:migrate:deploy",
    "db:seed": "pnpm --filter @financemanager/db db:seed",
    "db:studio": "pnpm --filter @financemanager/db db:studio",
    "db:reset": "pnpm --filter @financemanager/db db:reset",
    "encrypt:backfill": "pnpm --filter @financemanager/db encrypt:backfill",
    "key:rotate": "pnpm --filter @financemanager/db key:rotate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "sharp": "^0.35.0",
      "brace-expansion": "^5.0.8",
      "nanoid": "^3.3.18",
      "js-yaml": "^4.3.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
