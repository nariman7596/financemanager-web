// FinanceManager data model
// ---------------------------------------------------------------------------
// PostgreSQL everywhere (dev + prod), run via Docker — see docs/DOCKER.md.
// Locally: `docker compose -f docker-compose.dev.yml up -d` gives you Postgres;
// in production the app + its Postgres run as containers (docker-compose.yml).
// Note: Postgres has native enums, but we keep "enum-like" fields as validated
// strings (see src/lib/constants.ts + zod) to stay portable.
//
// If you have a pooled Postgres (e.g. serverless), add:
//   directUrl = env("DIRECT_URL")   // direct connection for migrations
//
// OWNERSHIP MODEL: financial data belongs to a Household, not a User. Users
// join households via Membership (with a role); every query is scoped by
// householdId and gated by the caller's membership + role (src/lib/household.ts).
// `createdById` records who added a row (informational; a plain id, no FK).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled Postgres (Neon/Supabase/serverless) needs a direct connection for
  // migrations. Set both in production; locally they can be the same value.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  baseCurrency String   @default("USD") // personal default for new households
  locale       String   @default("en") // preferred UI language (en | fa)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  apiTokens   ApiToken[]
}

// A shared financial space. A user working solo has a household of one.
model Household {
  id           String   @id @default(cuid())
  name         String
  baseCurrency String   @default("USD") // reporting currency for this household
  /// Budget planner inputs kept between visits: savings rate, rent, other fixed
  /// costs, protected category ids. Income is not kept — it is read from last
  /// month's actual income each time. See core/budgets/plan.ts.
  budgetPlan   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members           Membership[]
  invitations       Invitation[]
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  investments       Investment[]
  recurring         RecurringTransaction[]
  plaidItems        PlaidItem[]
  smsMessages       SmsMessage[]
  apiTokens         ApiToken[]
  categoryRules     CategoryRule[]
  goals             Goal[]
  netWorthSnapshots NetWorthSnapshot[]
  wallets           Wallet[]
}

// Links a user to a household with a role.
// Roles (rank): VIEWER < MEMBER < ADMIN < OWNER.
model Membership {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  role        String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId])
}

// A pending invitation to join a household, keyed by email. Accepting it
// creates a Membership; the invitee may already have an account or sign up later.
model Invitation {
  id          String   @id @default(cuid())
  householdId String
  email       String // lowercased invitee email
  role        String   @default("MEMBER")
  invitedById String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
  @@index([email])
}

// A place money lives: checking, savings, cash, credit card, etc.
model Account {
  id             String   @id @default(cuid())
  householdId    String
  createdById    String?
  name           String
  type           String   @default("CHECKING") // CHECKING | SAVINGS | CASH | CREDIT_CARD | INVESTMENT | OTHER
  currency       String   @default("USD")
  openingBalance Decimal  @default(0)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Bank sync (see src/lib/plaid.ts): set when this Account is linked to a
  // real bank account via Plaid instead of being purely manually tracked.
  source         String  @default("MANUAL") // MANUAL | PLAID
  plaidItemId    String?
  plaidAccountId String? // Plaid's account_id within the item

  // SMS import (see src/lib/sms.ts): the account/card number this account's
  // bank prints in its SMS (matched on trailing digits, so "3623" is enough),
  // or — for banks that print no number, like Blu — the bank's name as on the
  // message's first line ("بلو").
  smsMatch String?

  household            Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plaidItem            PlaidItem?             @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions         Transaction[]          @relation("AccountTransactions")
  transferTransactions Transaction[]          @relation("TransferAccount")
  investments          Investment[]           @relation("InvestmentAccount")
  // Holdings bought and kept for this person (a PERSON account).
  heldInvestments      Investment[]           @relation("HeldFor")
  recurring            RecurringTransaction[] @relation("RecurringAccount")
  recurringTransfers   RecurringTransaction[] @relation("RecurringTransferAccount")
  transferRules        CategoryRule[]

  @@unique([plaidItemId, plaidAccountId])
  @@index([householdId])
}

// Income / expense category.
model Category {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  name        String
  type        String   @default("EXPENSE") // INCOME | EXPENSE
  color       String   @default("#328eff")
  icon        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]
  rules        CategoryRule[]

  @@unique([householdId, name, type])
  @@index([householdId])
}

// A single money movement.
model Transaction {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  accountId   String
  categoryId  String?
  type        String   @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  amount      Decimal // always positive; `type` gives the direction
  currency    String   @default("USD")
  date        DateTime @default(now())
  description String?
  notes       String?

  // Legacy per-transaction recurrence flags (unused; see RecurringTransaction).
  isRecurring Boolean @default(false)
  recurrence  String?

  transferAccountId String?
  recurringId       String?

  // Bank sync: set when this row was materialized from a Plaid transaction
  // (see src/lib/plaid.ts). plaidTransactionId is the dedup key — sync
  // upserts on it instead of blindly inserting, unlike the CSV importer.
  plaidTransactionId String? @unique
  pending            Boolean @default(false)

  // Where the row came from: MANUAL | SMS (more sources may follow). An SMS
  // row is booked immediately so balances are right, but flagged for the user
  // to pick its category; bankBalance is the balance the bank reported.
  origin      String   @default("MANUAL")
  needsReview Boolean  @default(false)
  bankBalance Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account               @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?              @relation("TransferAccount", fields: [transferAccountId], references: [id])
  category        Category?             @relation(fields: [categoryId], references: [id])
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  smsMessage      SmsMessage?

  @@index([householdId, date])
  @@index([householdId, needsReview])
  @@index([accountId])
  @@index([categoryId])
  @@index([recurringId])
}

// A recurring rule / template (see src/lib/recurring.ts).
model RecurringTransaction {
  id                String  @id @default(cuid())
  householdId       String
  createdById       String?
  accountId         String
  categoryId        String?
  transferAccountId String?
  type              String  @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  amount            Decimal
  currency          String  @default("USD")
  description       String?
  notes             String?

  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  interval    Int       @default(1) // every N frequency units
  // Calendar the MONTHLY/YEARLY step is measured in. "Monthly" means the same
  // day of the next month in the calendar the owner actually uses: a rule set
  // for 15 Mordad must post on 15 Shahrivar, not 3 days off it. Frozen on the
  // rule so changing the UI language never shifts money that is already
  // scheduled. Ignored for DAILY/WEEKLY, which are calendar-independent.
  calendar    String    @default("GREGORIAN") // GREGORIAN | JALALI
  startDate   DateTime // first occurrence
  nextRunDate DateTime // next date to post
  endDate     DateTime? // optional stop date (inclusive)
  lastPosted  DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account       @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?      @relation("RecurringTransferAccount", fields: [transferAccountId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  transactions    Transaction[]

  @@index([householdId])
  @@index([isActive, nextRunDate])
}

// Monthly/weekly/yearly spending target for a category.
model Budget {
  id          String   @id @default(cuid())
  householdId String
  createdById String?
  categoryId  String
  amount      Decimal
  currency    String   @default("USD")
  period      String   @default("MONTHLY") // WEEKLY | MONTHLY | YEARLY
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, period])
  @@index([householdId])
}

// An investment holding: stock, crypto, ETF, etc.
model Investment {
  id           String   @id @default(cuid())
  householdId  String
  createdById  String?
  accountId    String?
  symbol       String
  name         String
  type         String   @default("STOCK") // STOCK | ETF | CRYPTO | BOND | REAL_ESTATE | CASH | OTHER
  quantity     Decimal
  costBasis    Decimal
  currentPrice Decimal  @default(0)
  currency     String   @default("USD")
  purchaseDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Kept for someone else (a PERSON account): its value and its gains are
  // theirs, so it counts as their money you hold rather than your own.
  heldForId String?

  // Read from a wallet's address on a chain (see lib/wallets.ts): quantity
  // follows the chain; `walletAsset` is core/wallets' key ("arbitrum:USDC").
  walletId    String?
  walletAsset String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?  @relation("InvestmentAccount", fields: [accountId], references: [id])
  heldFor   Account?  @relation("HeldFor", fields: [heldForId], references: [id], onDelete: SetNull)
  wallet    Wallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, walletAsset])
  @@index([householdId])
}

// A self-custody wallet followed read-only: public addresses only — never a
// key, seed phrase or access code. Its balances become Investment rows.
model Wallet {
  id          String    @id @default(cuid())
  householdId String
  createdById String?
  name        String
  // Address kind (core/wallets ADDRESS_KINDS) -> public address.
  addresses   Json
  syncedAt    DateTime?
  // Chain -> error, for the chains the last sync could not read.
  errors      Json?
  // Staking pools found in the address's history ({ ton: ["0:<hex>"] }),
  // kept so a deposit that scrolls out of the recent history still counts.
  stakePools  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  holdings  Investment[]

  @@index([householdId])
}

// A linked bank connection via Plaid (see src/lib/plaid.ts). One item can
// cover multiple of the institution's accounts; each gets mapped to at most
// one local Account (Account.plaidItemId/plaidAccountId).
model PlaidItem {
  id                 String    @id @default(cuid())
  householdId        String
  createdById        String?
  itemId             String    @unique // Plaid item_id
  accessToken        String // AES-256-GCM encrypted, see src/lib/crypto.ts
  institutionName    String?
  status             String    @default("ACTIVE") // ACTIVE | ERROR | REVOKED
  error              String?
  transactionsCursor String? // Plaid /transactions/sync cursor
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@index([householdId])
}

// Exchange rate cache for multi-currency conversion (quote per 1 base).
model ExchangeRate {
  id    String   @id @default(cuid())
  base  String
  quote String
  rate  Decimal
  asOf  DateTime @default(now())

  @@unique([base, quote])
}

// What an Iranian exchange last quoted for a coin, in toman. The official
// USD->IRR rate is far from what anyone pays, so holdings priced in toman take
// their price from the market itself — from each exchange the owner trades on.
model MarketQuote {
  id     String   @id @default(cuid())
  symbol String // "USDT"
  source String // wallex | nobitex | tabdeal
  price  Decimal // toman per unit
  asOf   DateTime @default(now())

  @@unique([symbol, source])
}

// Every bank SMS the phone forwarded, whether or not it became a transaction.
// `hash` (of the normalised text) makes delivery idempotent: the iOS shortcut
// re-sends its whole queue until the server acknowledges it, so the same
// message arriving twice must be a no-op. Messages that could not be read or
// matched to an account stay here for the user to retry or dismiss.
model SmsMessage {
  id            String   @id @default(cuid())
  householdId   String
  createdById   String?
  body          String
  hash          String
  status        String // BOOKED | UNPARSED | UNMATCHED | IGNORED | DISMISSED
  transactionId String?  @unique
  receivedAt    DateTime @default(now())

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([householdId, hash])
  @@index([householdId, status])
}

// A key that lets a device post into one household without a browser session
// (the iOS shortcut). Only the SHA-256 of the token is stored; the token is
// shown once at creation. `prefix` identifies it in the UI.
model ApiToken {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  name        String
  tokenHash   String    @unique
  prefix      String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

/// "Always file this description under that category" — or "always record it
/// as a transfer to that account" (a loan instalment, money for a person).
/// Created from the Review page; applied when an SMS is booked, so a known
/// merchant never waits for a tap. `match` is the normalised description (see
/// core/sms/rules.ts); `type` keeps an expense rule from ever filing an income.
/// Exactly one of categoryId / transferAccountId is set.
model CategoryRule {
  id                String   @id @default(cuid())
  householdId       String
  createdById       String?
  type              String // INCOME | EXPENSE
  match             String
  categoryId        String?
  transferAccountId String?
  createdAt         DateTime @default(now())

  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transferAccount Account?  @relation(fields: [transferAccountId], references: [id], onDelete: Cascade)

  @@unique([householdId, type, match])
  @@index([householdId])
}

// A savings goal ("a car by Nowruz", "monthly investing"). Its progress is
// either what is in the accounts and holdings it is linked to (LINKED — the
// money sits somewhere of its own) or the sum of what was set aside for it by
// hand (MANUAL — the money stays mixed with the rest, the goal only labels it).
model Goal {
  id            String    @id @default(cuid())
  householdId   String
  createdById   String?
  name          String
  targetAmount  Decimal
  currency      String
  targetDate    DateTime?
  source        String    @default("MANUAL") // MANUAL | LINKED
  accountIds    String[]  @default([])
  investmentIds String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([householdId])
}

// Money set aside for a MANUAL goal (negative: taken back out).
model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  amount    Decimal
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// The household's worth on one day, written by the hourly refresh (the last
// write of the day stands). Cash can be rebuilt from transactions for any day,
// but what holdings were worth on a past day cannot — this keeps it, and the
// dollar rate of that day so worth can also be read in dollars.
model NetWorthSnapshot {
  id          String   @id @default(cuid())
  householdId String
  day         DateTime // midnight UTC of the day
  currency    String // the household's base currency at the time
  cash        Decimal
  investments Decimal
  // Toman per USDT that day (Iranian exchanges), when known.
  usdRate     Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, day])
}
