# ---------------------------------------------------------------------------
# FinanceManager environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Database connection.
# DEV (default): local SQLite file — zero setup, just works.
DATABASE_URL="file:./dev.db"
#
# PROD example (PostgreSQL). To switch:
#   1. Set the `provider` in prisma/schema.prisma to "postgresql"
#   2. Use a URL like the one below
# DATABASE_URL="postgresql://user:password@localhost:5432/financemanager?schema=public"

# Secret used to sign session JWTs. MUST be a long random string in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Live market data (all optional — the app works without them using seeded
# rates and manually-entered prices).
# ---------------------------------------------------------------------------

# Secret that protects the scheduled refresh endpoint /api/cron/refresh.
# If unset, that endpoint is disabled (the in-app "Refresh" button still works).
# Point a scheduler at it, e.g.:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-app/api/cron/refresh
# CRON_SECRET="another-long-random-string"

# Optional overrides for the FX provider (default: keyless open.er-api.com).
# FX_API_URL="https://open.er-api.com/v6/latest/USD"
# COINGECKO_API_URL="https://api.coingecko.com/api/v3/simple/price"

# Optional stock/ETF price provider (Finnhub). Without it, crypto still
# refreshes but stock prices stay manual. Get a free key at finnhub.io.
# STOCK_API_KEY="your-finnhub-api-key"
