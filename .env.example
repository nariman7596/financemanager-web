# ---------------------------------------------------------------------------
# FinanceManager environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Database connection (PostgreSQL).
# Local dev: start Postgres with `docker compose -f docker-compose.dev.yml up -d`
# then use the URL below. In Docker/prod, compose sets this for you (see
# docker-compose.yml + docs/DOCKER.md).
DATABASE_URL="postgresql://fm:devpassword@localhost:5432/financemanager?schema=public"
#
# DIRECT_URL is REQUIRED — the datasource references it (schema.prisma).
# With a pooled Postgres (Neon/Supabase/serverless), DATABASE_URL is the pooled
# connection and DIRECT_URL is the direct one, used for migrations.
# Locally (plain Postgres) just set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://fm:devpassword@localhost:5432/financemanager?schema=public"

# Secret used to sign session JWTs. MUST be a long random string in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Live market data (all optional — the app works without them using seeded
# rates and manually-entered prices).
# ---------------------------------------------------------------------------

# Secret that protects the scheduled refresh endpoint /api/cron/refresh.
# If unset, that endpoint is disabled (the in-app "Refresh" button still works).
# Point a scheduler at it, e.g.:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-app/api/cron/refresh
# CRON_SECRET="another-long-random-string"

# Optional overrides for the FX provider (default: keyless open.er-api.com).
# FX_API_URL="https://open.er-api.com/v6/latest/USD"
# COINGECKO_API_URL="https://api.coingecko.com/api/v3/simple/price"

# Optional stock/ETF price provider (Finnhub). Without it, crypto still
# refreshes but stock prices stay manual. Get a free key at finnhub.io.
# STOCK_API_KEY="your-finnhub-api-key"

# ---------------------------------------------------------------------------
# Bank sync (Plaid, optional — without it, accounts must be entered/imported
# manually; the "Connect a bank" UI is hidden).
# ---------------------------------------------------------------------------

# Get free Sandbox keys instantly (no approval wait) at dashboard.plaid.com.
# Sandbox test login for any institution: user_good / pass_good.
# PLAID_CLIENT_ID="your-plaid-client-id"
# PLAID_SECRET="your-plaid-sandbox-secret"
# PLAID_ENV="sandbox"   # sandbox | development | production

# Encrypts PlaidItem.accessToken at rest (a live bank-access credential).
# Required once PLAID_CLIENT_ID/PLAID_SECRET are set. Generate with:
#   openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY="another-long-random-string"

# Scheduled bank-sync endpoint /api/cron/bank-sync reuses CRON_SECRET above.

# --- API (apps/api, the transport the mobile client uses) -------------------
# Port the NestJS API listens on. The web app and the API share AUTH_SECRET:
# access tokens carry a `scope: "api"` claim so a web session cookie cannot be
# replayed as an API bearer token, and vice versa.
API_PORT=3001

# --- Encryption at rest (docs/ENCRYPTION.md) --------------------------------
# Master key wrapping each household's data key. Encrypts narrative fields:
# transaction descriptions/notes, raw SMS bodies and Plaid access tokens.
# Amounts and dates stay in the clear so reports can aggregate in SQL.
#
#   openssl rand -base64 32
#
# ⚠️ Back this up SEPARATELY from the database. It is not in the dump, and
# losing it loses every encrypted field permanently.
TOKEN_ENCRYPTION_KEY=
